{
  "name": "axessia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:upload": "node --env-file=.env scripts/test-prescription-upload.mjs",
    "test:files": "node --env-file=.env scripts/test-file-operations.mjs",
    "check:storage": "node --env-file=.env.local scripts/check-storage.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^13.1.1",
    "git": "^0.1.5",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "pdf-lib": "^1.17.1",
    "prisma": "6.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
