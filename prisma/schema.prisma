generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum QuoteRequestStatus {
  RECEIVED
  SOURCING
  QUOTED
  AWAITING_DECISION
  ACCEPTED
  SHIPPING
  REJECTED
  CANCELLED
  COMPLETED
}

enum QuoteStatus {
  DRAFT
  READY
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  VOIDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  HELP_REQUESTED
}

enum PaymentProvider {
  SIMULATED
  BANCHILE
}

enum QuoteItemCondition {
  AVAILABLE
  SPECIAL_IMPORT
}

enum UserRole {
  EJECUTIVO
  ADMINISTRADOR
}

enum InternalInvitationStatus {
  PENDING
  USED
  EXPIRED
  INVALID
}

enum QuoteRequestOrigin {
  WEB
  EJECUTIVO
}

model User {
  id                 String                    @id @default(cuid())
  firstName          String
  lastName           String
  email              String                    @unique
  rut                String                    @unique
  phone              String?
  role               UserRole                  @default(EJECUTIVO)
  passwordHash       String?
  avatarUrl          String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  quoteRequestEvents QuoteRequestEvent[]
  assignedRequests   QuoteRequest[]            @relation("AssignedExecutiveRequests")
  invitationsSent    InternalUserInvitation[]  @relation("InvitationSentBy")
}

model InternalUserInvitation {
  id          String                    @id @default(cuid())
  email       String
  rut         String
  role        UserRole
  token       String                    @unique
  status      InternalInvitationStatus  @default(PENDING)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime                  @default(now())
  sentAt      DateTime?
  invitedById String?
  invitedBy   User?                     @relation("InvitationSentBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([rut])
  @@index([status, expiresAt])
}

model Customer {
  id                String         @id @default(cuid())
  name              String
  phone             String
  email             String         @unique
  rut               String         @unique
  city              String
  passwordHash      String?
  hasPendingRequest Boolean        @default(false)
  promotionsConsent Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  requests          QuoteRequest[]
  prescriptions     Prescription[]
  quotes            Quote[]
}

model QuoteRequest {
  sequence             Int                   @id @default(autoincrement())
  id                   String                @unique @default(cuid())
  requestNumber        String?               @unique
  customerId           String?
  requesterName        String
  requesterPhone       String
  requesterEmail       String
  requesterRut         String
  requesterCity        String
  patientName          String?
  patientRut           String?
  status               QuoteRequestStatus    @default(RECEIVED)
  origin               QuoteRequestOrigin    @default(WEB)
  assignedExecutiveId  String?
  acceptsPolicies      Boolean
  acceptsDataTreatment Boolean
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  customer             Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedExecutive    User?                 @relation("AssignedExecutiveRequests", fields: [assignedExecutiveId], references: [id], onDelete: SetNull)
  prescriptions        Prescription[]
  clientDocuments      ClientDocument[]
  generatedMandate     GeneratedMandate?
  mandateDocuments     MandateDocument[]
  medications          Medication[]
  quotes               Quote[]
  comments             QuoteRequestComment[]
  internalNotes        QuoteRequestNote[]
  events               QuoteRequestEvent[]
  notifications        Notification[]
  payments             Payment[]

  @@index([customerId])
  @@index([status])
  @@index([requesterEmail])
  @@index([requesterRut])
  @@index([assignedExecutiveId])
  @@index([origin])
}

model GeneratedMandate {
  id        String       @id @default(cuid())
  requestId String       @unique
  fileName  String
  storageKey String      @unique
  generatedAt DateTime   @default(now())
  sentAt    DateTime?
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model ClientDocument {
  id        String       @id @default(cuid())
  requestId String
  fileName  String
  mimeType  String
  fileSize  Int
  storageKey String?
  createdAt DateTime     @default(now())
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model MandateDocument {
  id        String       @id @default(cuid())
  requestId String
  fileName  String
  mimeType  String
  fileSize  Int
  storageKey String?
  createdAt DateTime     @default(now())
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  requestId String
  type      NotificationType @default(NEW_REQUEST)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  request   QuoteRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([isRead, createdAt])
}

enum NotificationType {
  NEW_REQUEST
  QUOTE_ACCEPTED
  QUOTE_REJECTED
}

model Prescription {
  id         String       @id @default(cuid())
  requestId  String
  customerId String?
  fileName   String
  mimeType   String
  fileSize   Int
  storageKey String?
  createdAt  DateTime     @default(now())
  request    QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([customerId])
}

model Medication {
  id               String       @id @default(cuid())
  requestId        String
  commercialName   String
  activeIngredient String
  concentration    String
  tabletQuantity   Int
  createdAt        DateTime     @default(now())
  request          QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Quote {
  sequence             Int                   @id @default(autoincrement())
  id                   String                @unique @default(cuid())
  customerId           String
  requestId            String
  quoteNumber          String?               @unique
  version              Int                   @default(1)
  status               QuoteStatus           @default(DRAFT)
  total                Decimal?              @db.Decimal(12, 2)
  validUntil           DateTime?
  sentAt               DateTime?
  acceptedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  request              QuoteRequest          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  items                QuoteItem[]
  quoteRequestComments QuoteRequestComment[]
  payments             Payment[]

  @@unique([requestId, version])
  @@index([requestId])
  @@index([customerId])
  @@index([status])
}

model Payment {
  id                String          @id @default(cuid())
  requestId         String
  quoteId           String
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("CLP")
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider @default(SIMULATED)
  providerReference String?         @unique
  checkoutUrl       String?         @db.Text
  failureReason     String?         @db.Text
  helpMessage       String?         @db.Text
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  request           QuoteRequest    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  quote             Quote           @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([quoteId])
  @@index([status])
  @@index([providerReference])
}

model QuoteItem {
  id                 String              @id @default(cuid())
  quoteId            String
  productName        String
  activeIngredient   String?
  concentration      String?
  pharmaceuticalForm String?
  presentation       String?
  unitsPerPackage    Int?
  manufacturer       String?
  originCountry      String?
  supplierCountry    String?
  quantity           Int
  sanitaryRegistry   String?
  condition          QuoteItemCondition?
  batchNumber        String?
  expirationDate     DateTime?
  unitPrice          Decimal?            @db.Decimal(12, 2)
  totalPrice         Decimal?            @db.Decimal(12, 2)
  createdAt          DateTime            @default(now())
  quote              Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteRequestComment {
  id         String       @id @default(cuid())
  requestId  String
  quoteId    String?
  authorType String
  message    String       @db.Text
  createdAt  DateTime     @default(now())
  request    QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quote      Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([quoteId])
}

model QuoteRequestNote {
  id            String       @id @default(cuid())
  requestId     String
  executiveName String
  message       String       @db.Text
  createdAt     DateTime     @default(now())
  request       QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model QuoteRequestEvent {
  id        String             @id @default(cuid())
  requestId String
  status    QuoteRequestStatus
  eventType String
  note      String?            @db.Text
  actorId   String?
  createdAt DateTime           @default(now())
  request   QuoteRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorId])
}
