generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum QuoteRequestStatus {
  RECEIVED
  SOURCING
  QUOTED
  AWAITING_DECISION
  ACCEPTED
  PAID
  SHIPPING
  REJECTED
  CANCELLED
  COMPLETED
}

enum QuoteStatus {
  DRAFT
  READY
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  VOIDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  HELP_REQUESTED
}

enum PaymentProvider {
  SIMULATED
  BANCHILE
  TRANSFER
}

enum QuoteItemCondition {
  AVAILABLE
  SPECIAL_IMPORT
}

enum UserRole {
  EJECUTIVO
  ADMINISTRADOR
}

enum InternalInvitationStatus {
  PENDING
  USED
  EXPIRED
  INVALID
}

enum QuoteRequestOrigin {
  WEB
  EJECUTIVO
  DIRECT_QUOTE
}

enum ProductType {
  MEDICATION
  MEDICAL_DEVICE
}

enum ClientDocumentKind {
  MANDATE
  ID_FRONT
  ID_BACK
  TRANSFER_RECEIPT
  OTHER
}

model User {
  id                 String                         @id @default(cuid())
  firstName          String
  lastName           String
  email              String                         @unique
  rut                String                         @unique
  phone              String?
  role               UserRole                       @default(EJECUTIVO)
  passwordHash       String?
  avatarUrl          String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  quoteRequestEvents QuoteRequestEvent[]
  assignedRequests   QuoteRequest[]                 @relation("AssignedExecutiveRequests")
  invitationsSent    InternalUserInvitation[]       @relation("InvitationSentBy")
  passwordResetTokens InternalPasswordResetToken[]
}

model InternalPasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
}

model InternalUserInvitation {
  id          String                    @id @default(cuid())
  email       String
  rut         String
  role        UserRole
  token       String                    @unique
  status      InternalInvitationStatus  @default(PENDING)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime                  @default(now())
  sentAt      DateTime?
  invitedById String?
  invitedBy   User?                     @relation("InvitationSentBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([rut])
  @@index([status, expiresAt])
}

model Customer {
  id                String         @id @default(cuid())
  name              String
  phone             String
  email             String         @unique
  rut               String         @unique
  city              String
  passwordHash      String?
  hasPendingRequest Boolean        @default(false)
  promotionsConsent Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  requests          QuoteRequest[]
  prescriptions     Prescription[]
  quotes                     Quote[]
  customerEmailNotifications CustomerEmailNotification[]
  passwordResetTokens        CustomerPasswordResetToken[]
}

model CustomerPasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, usedAt, expiresAt])
}

/// Operational supplier registry. Future purchases, quotes and cases can reference `id`.
model Supplier {
  id            String      @id @default(cuid())
  name          String
  /// Flexible commercial or internal number. Not a Chilean RUT; stores foreign IDs as-is.
  identifier    String?
  phone         String?
  contactName   String?
  email         String?
  manufacturer  String?
  originCountry String?
  country       String?
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  quoteItems    QuoteItem[]
  products      Product[]

  @@index([name])
  @@index([identifier])
  @@index([contactName])
  @@index([email])
  @@index([createdAt])
}

model QuoteRequest {
  sequence             Int                   @id @default(autoincrement())
  id                   String                @unique @default(cuid())
  requestNumber        String?               @unique
  customerId           String?
  requesterName        String
  requesterPhone       String
  requesterEmail       String
  requesterRut         String
  requesterCity        String
  patientName          String?
  patientRut           String?
  status               QuoteRequestStatus    @default(RECEIVED)
  origin               QuoteRequestOrigin    @default(WEB)
  productType          ProductType           @default(MEDICATION)
  assignedExecutiveId  String?
  acceptsPolicies      Boolean
  acceptsDataTreatment Boolean
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  customer             Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedExecutive    User?                 @relation("AssignedExecutiveRequests", fields: [assignedExecutiveId], references: [id], onDelete: SetNull)
  prescriptions        Prescription[]
  clientDocuments      ClientDocument[]
  generatedMandate     GeneratedMandate?
  mandateDocuments     MandateDocument[]
  medications          Medication[]
  medicalDevices       MedicalDevice[]
  quotes               Quote[]
  comments             QuoteRequestComment[]
  chatMessages         ChatMessage[]
  internalNotes        QuoteRequestNote[]
  events               QuoteRequestEvent[]
  notifications              Notification[]
  payments                   Payment[]
  customerEmailNotifications CustomerEmailNotification[]

  @@index([customerId])
  @@index([status])
  @@index([requesterEmail])
  @@index([requesterRut])
  @@index([assignedExecutiveId])
  @@index([origin])
  @@index([productType])
}

model GeneratedMandate {
  id        String       @id @default(cuid())
  requestId String       @unique
  fileName  String
  storageKey String      @unique
  generatedAt DateTime   @default(now())
  sentAt    DateTime?
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model ClientDocument {
  id            String              @id @default(cuid())
  requestId     String
  fileName      String
  mimeType      String
  fileSize      Int
  storageKey    String?
  documentKind  ClientDocumentKind?
  customLabel   String?
  createdAt     DateTime            @default(now())
  request       QuoteRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model MandateDocument {
  id        String       @id @default(cuid())
  requestId String
  fileName  String
  mimeType  String
  fileSize  Int
  storageKey String?
  createdAt DateTime     @default(now())
  request   QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  requestId String
  type      NotificationType @default(NEW_REQUEST)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  request   QuoteRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([isRead, createdAt])
}

enum NotificationType {
  NEW_REQUEST
  QUOTE_ACCEPTED
  QUOTE_REJECTED
}

enum CustomerEmailNotificationType {
  QUOTE_PENDING_REMINDER
  QUOTE_EXPIRING_SOON
  REQUEST_COMPLETED
}

enum CustomerEmailNotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Prescription {
  id         String       @id @default(cuid())
  requestId  String
  customerId String?
  fileName   String
  mimeType   String
  fileSize   Int
  storageKey String?
  createdAt  DateTime     @default(now())
  request    QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([customerId])
}

model Medication {
  id               String       @id @default(cuid())
  requestId        String
  commercialName   String
  activeIngredient String
  concentration    String
  tabletQuantity   Int?
  notes            String?      @db.Text
  createdAt        DateTime     @default(now())
  request          QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model MedicalDevice {
  id          String       @id @default(cuid())
  requestId   String
  name        String
  brand       String?
  model       String?
  quantity    Int?
  description String?      @db.Text
  createdAt   DateTime     @default(now())
  request     QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Quote {
  sequence             Int                   @id @default(autoincrement())
  id                   String                @unique @default(cuid())
  customerId           String
  requestId            String
  quoteNumber          String?               @unique
  version              Int                   @default(1)
  status               QuoteStatus           @default(DRAFT)
  total                Decimal?              @db.Decimal(12, 2)
  validUntil           DateTime?
  estimatedShippingDays Int?
  sentAt               DateTime?
  acceptedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  request              QuoteRequest          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  items                      QuoteItem[]
  quoteRequestComments       QuoteRequestComment[]
  payments                   Payment[]
  customerEmailNotifications CustomerEmailNotification[]

  @@unique([requestId, version])
  @@index([requestId])
  @@index([customerId])
  @@index([status])
}

model Payment {
  id                String          @id @default(cuid())
  requestId         String
  quoteId           String
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("CLP")
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider @default(SIMULATED)
  providerReference String?         @unique
  checkoutUrl       String?         @db.Text
  failureReason     String?         @db.Text
  helpMessage       String?         @db.Text
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  request           QuoteRequest    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  quote             Quote           @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([quoteId])
  @@index([status])
  @@index([providerReference])
}

model QuoteItem {
  id                 String              @id @default(cuid())
  quoteId            String
  productId          String?
  productType        ProductType         @default(MEDICATION)
  productName        String
  activeIngredient   String?
  concentration      String?
  pharmaceuticalForm String?
  brand              String?
  model              String?
  description        String?             @db.Text
  presentation       String?
  unitsPerPackage    Int?
  manufacturer       String?
  originCountry      String?
  supplierCountry    String?
  supplierId         String?
  quantity           Int
  sanitaryRegistry   String?
  condition          QuoteItemCondition?
  batchNumber        String?
  expirationDate     DateTime?
  unitPrice          Decimal?            @db.Decimal(12, 2)
  totalPrice         Decimal?            @db.Decimal(12, 2)
  unitCost           Decimal?            @db.Decimal(12, 2)
  createdAt          DateTime            @default(now())
  quote              Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([quoteId])
  @@index([supplierId])
}

model CustomerEmailNotification {
  id                String                            @id @default(cuid())
  occurrenceKey     String                            @unique
  type              CustomerEmailNotificationType
  status            CustomerEmailNotificationStatus   @default(PENDING)
  customerId        String?
  quoteId           String?
  requestId         String?
  recipientEmail    String
  providerMessageId String?
  errorMessage      String?                           @db.Text
  sentAt            DateTime?
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt
  customer          Customer?                         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quote             Quote?                            @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  request           QuoteRequest?                     @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([quoteId, type, status])
  @@index([requestId, type, status])
  @@index([status, createdAt])
}

model QuoteRequestComment {
  id         String       @id @default(cuid())
  requestId  String
  quoteId    String?
  authorType String
  message    String       @db.Text
  createdAt  DateTime     @default(now())
  request    QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quote      Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([quoteId])
}

model Product {
  id                 String      @id @default(cuid())
  productType        ProductType
  productName        String
  activeIngredient   String?
  concentration      String?
  pharmaceuticalForm String?
  brand              String?
  model              String?
  description        String?     @db.Text
  presentation       String?
  unitsPerPackage    Int?
  manufacturer       String?
  originCountry      String?
  supplierCountry    String?
  supplierId         String?
  sanitaryRegistry   String?
  condition          QuoteItemCondition?
  cost               Decimal     @db.Decimal(12, 2)
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  quoteItems         QuoteItem[]
  supplier            Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([productType, productName])
  @@index([supplierId])
  @@index([isActive, createdAt])
}

model ChatMessage {
  id              String      @id @default(cuid())
  requestId       String
  authorType      String
  message         String      @db.VarChar(2000)
  imageStorageKey String?
  imageFileName   String?
  imageMimeType   String?
  imageFileSize   Int?
  createdAt       DateTime    @default(now())
  request         QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model QuoteRequestNote {
  id            String       @id @default(cuid())
  requestId     String
  executiveName String
  message       String       @db.Text
  createdAt     DateTime     @default(now())
  request       QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model QuoteRequestEvent {
  id        String             @id @default(cuid())
  requestId String
  status    QuoteRequestStatus
  eventType String
  note      String?            @db.Text
  actorId   String?
  createdAt DateTime           @default(now())
  request   QuoteRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorId])
}
